---
import MainLayout from '../../layouts/MainLayout.astro';

// ▼ ハードコーディングする運営の連絡先
const adminEmail = "info@amber-links.com";
---

<MainLayout title="お問い合わせ">

  <div class="max-w-4xl mx-auto">
    
    <section class="text-center mb-10">
      <h1 class="text-2xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-600 mb-4">
        お問い合わせ
      </h1>
    </section>

    <div class="bg-gradient-to-r from-blue-50 to-cyan-50 rounded-2xl p-5 md:p-8 border-2 border-blue-200 mb-8">
      <h2 class="font-bold text-lg md:text-xl text-blue-800 mb-3 flex items-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        個別の保護犬に関するお問い合わせ
      </h2>
      <p class="text-gray-700 mb-4 text-base">
        「〇〇ちゃんについて知りたい」「面会したい」といった、**個別の犬に関するお問い合わせ**は、当ポータルではお答えできません。
      </p>
      <p class="text-gray-700 font-semibold mb-4 text-base">
        各犬の詳細ページに記載されている「この子について問い合わせる」ボタンより、直接、保護団体様へご連絡ください。
      </p>
      <a 
        href="/" 
        class="inline-flex items-center px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-lg transition-colors text-base"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        犬を探すページへ
      </a>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-5 md:p-10 border-2 border-orange-100">
      <h2 class="font-bold text-lg md:text-xl text-gray-800 mb-3 flex items-center">
        <svg class="w-6 h-6 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        ポータルサイト運営について
      </h2>
      <p class="text-gray-700 mb-4 text-base">
        「サイトが正しく表示されない」「情報の掲載を希望する（団体様向け）」「その他、当ポータルの運営に関するご連絡」は、以下の連絡先までお願いいたします。
      </p>
      
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <p class="text-sm text-gray-600">運営事務局 メールアドレス:</p>
        <a href={`mailto:${adminEmail}`} class="text-base md:text-lg font-bold text-orange-600 hover:text-orange-700 break-all">
          {adminEmail}
        </a>
      </div>
    </div>

  </div>
</MainLayout>