---
import { client } from '../../lib/microcms';
import type { Article, MicroCMSListResponse } from '../../types';
import MainLayout from '../../layouts/MainLayout.astro';

// microCMSから記事データを全件取得
const response = await client.get<MicroCMSListResponse<Article>>({
  endpoint: 'articles',
  queries: { 
    limit: 100, 
    orders: '-publishedAt' 
  }
});
const articles = response.contents;

// 日付をフォーマットする関数
function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<MainLayout title="記事一覧">
  
  <section class="text-center mb-12">
    <h1 class="text-3xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-600 mb-4">
      記事一覧
    </h1>
    <p class="text-gray-600 text-lg md:text-xl max-w-2xl mx-auto">
      保護犬たちのこと、イベントの告知などを発信します。
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {articles.map(article => (
      <a 
        href={`/articles/${article.id}/`}
        class="dog-card group bg-white rounded-2xl shadow-md hover:shadow-2xl overflow-hidden transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-orange-300"
      >
        <div class="relative overflow-hidden aspect-video">
          <img 
            src={article.eyecatch?.url || '/dog-placeholder.svg'} 
            alt={article.title}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
        </div>
        
        <div class="p-6">
          <p class="text-sm text-gray-500 mb-2">{formatDate(article.publishedAt)}</p>
          <h2 class="text-xl font-bold text-gray-800 mb-3 group-hover:text-orange-600 transition-colors">
            {article.title}
          </h2>
          </div>
      </a>
    ))}
  </div>

  {articles.length === 0 && (
    <div class="text-center py-16">
      <div class="inline-block p-8 bg-white rounded-2xl shadow-lg">
        <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h6m-1-4h.01"></path>
        </svg>
        <h3 class="text-xl font-bold text-gray-700 mb-2">記事がまだありません</h3>
        <p class="text-gray-500">新しい記事が公開されるまでお待ちください。</p>
      </div>
    </div>
  )}

</MainLayout>