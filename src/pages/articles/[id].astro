---
import { client } from '../../lib/microcms';
import type { Article } from '../../types';
import MainLayout from '../../layouts/MainLayout.astro';

// 1. getStaticPaths: ビルド時に実行され、ページを生成
export async function getStaticPaths() {
  const response = await client.getAllContents({
    endpoint: 'articles',
    queries: { 
      fields: 'id'
    }
  });
  return response.map((article) => ({
    params: { id: article.id },
  }));
}

// 2. ページコンポーネント
const { id } = Astro.params;
let article: Article | null = null;
try {
  article = await client.get<Article>({
    endpoint: 'articles',
    contentId: id,
  });
} catch (e) {
  console.error(e);
}

// 日付をフォーマットする関数
function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<MainLayout title={article ? article.title : '記事詳細'}>
  
  {article ? (
    <article class="max-w-4xl mx-auto">
      
      <nav class="mb-6 text-sm">
        <ol class="flex items-center space-x-2 text-gray-500">
          <li>
            <a href="/" class="hover:text-orange-600 transition-colors flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
              トップ
            </a>
          </li>
          <li>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </li>
          <li>
            <a href="/articles/" class="hover:text-orange-600 transition-colors">
              記事一覧
            </a>
          </li>
          <li>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </li>
          <li class="text-gray-800 font-medium line-clamp-1">{article.title}</li>
        </ol>
      </nav>

      <div class="bg-white rounded-2xl shadow-xl p-5 md:p-10 lg:p-12 border-2 border-orange-100">
        {article.eyecatch && (
          <div class="mb-6 md:mb-8 overflow-hidden rounded-xl aspect-video">
            <img 
              src={article.eyecatch.url} 
              alt={article.title} 
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <h1 class="text-2xl md:text-4xl font-bold text-gray-800 mb-4">
          {article.title}
        </h1>
        
        <p class="text-gray-500 mb-6 md:mb-8">
          公開日: {formatDate(article.publishedAt)}
        </p>

        <div 
          class="prose md:prose-lg max-w-none text-gray-700 leading-relaxed" 
          set:html={article.content} 
        />
      </div>

      <div class="mt-8 text-center">
        <a 
          href="/articles/" 
          class="inline-flex items-center px-8 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          記事一覧に戻る
        </a>
      </div>
      
    </article>
  ) : (
    <div class="text-center py-16">
      <div class="inline-block p-8 bg-white rounded-2xl shadow-lg">
        <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h2 class="text-2xl font-bold text-gray-700 mb-2">記事が見つかりませんでした</h2>
        <p class="text-gray-500 mb-6">指定されたIDの記事は存在しないか、削除された可能性があります。</p>
        <a 
          href="/articles/" 
          class="inline-flex items-center px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-lg transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          記事一覧へ
        </a>
      </div>
    </div>
  )}
  
</MainLayout>