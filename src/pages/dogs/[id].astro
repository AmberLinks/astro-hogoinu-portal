---
import { client } from '../../lib/microcms';
import type { Dog } from '../../types'; 
import MainLayout from '../../layouts/MainLayout.astro';

// 1. getStaticPaths: ビルド時に実行され、ページを生成
export async function getStaticPaths() {
  const response = await client.getAllContents({
    endpoint: 'dogs',
    queries: { 
      fields: 'id'
    }
  });
return response.map((dog) => ({
    params: { id: dog.id },
  }));
}

// 2. ページコンポーネント
const { id } = Astro.params;
let dog: Dog | null = null;
try {
  dog = await client.get<Dog>({
    endpoint: 'dogs',
    contentId: id,
    queries: { depth: 2 } // 団体(group)の情報を取得するため depth: 2
  });
} catch (e) {
  console.error(e);
}

const placeholderIcon = "/dog-placeholder.svg";

// データ正規化関数
const normalizeField = (field: string | string[] | undefined | null): string => {
  if (Array.isArray(field) && field.length > 0) {
    return field[0];
}
  if (typeof field === 'string') {
    return field;
  }
  return '';
};

// mailtoリンク用の変数（件名と本文の定型文）をここで生成します
let mailtoHref = '';
if (dog && dog.group && dog.group.email) {
  const groupName = dog.group.group_name || '団体';
  const dogName = dog.name || '保護犬';
  const email = dog.group.email;

  // 1. 件名
  const subject = `${groupName}様 ${dogName}ちゃんについてのお問い合わせ`;

  // 2. 本文（定型文）
  // \n はメール本文の改行です
  const body = `
${groupName} 様

静岡保護犬ポータルサイトを見て、${dogName}ちゃんの件でお問い合わせいたしました。

[以下に内容をご記入ください]


--------------------
・お名前:
・ご連絡先 (電話番号):
・ご住所 (市町村まで):
・お問い合わせ内容 (例: 譲渡条件について、面会希望など):
--------------------
`;

  // 3. mailtoリンクを生成 (件名と本文をURLエンコード)
  // encodeURIComponent を使って日本語が文字化けしないようにします
  mailtoHref = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}
---

<MainLayout title={dog ? dog.name : '詳細'}>
  
  {dog ?
(
    <div class="max-w-6xl mx-auto">
      
      <nav class="mb-6 text-sm">
        <ol class="flex items-center space-x-2 text-gray-500">
          <li>
            <a href="/" class="hover:text-orange-600 transition-colors flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
              トップ
            </a>
          </li>
          
<li>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </li>
          <li class="text-gray-800 font-medium line-clamp-1">{dog.name}</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 
mb-8">
        
        <div class="space-y-4">
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-2 border-orange-100">
            <div class="relative aspect-square">
              <img 
                src={dog.image_url ||
placeholderIcon} 
                alt={dog.name} 
                class="w-full h-full object-cover" 
              />
              
              {normalizeField(dog.status) && (
                <div class="absolute top-4 
right-4">
                  <span class="inline-block bg-gradient-to-r from-green-400 to-green-600 text-white text-sm font-bold px-4 py-2 rounded-full shadow-lg">
                    {normalizeField(dog.status)}
                  </span>
                </div>
              )}
   
         </div>
          </div>
          
          <div class="bg-white rounded-xl shadow-md p-4 border border-orange-100">
            <p class="text-sm text-gray-600 mb-3 font-medium flex items-center">
              <svg class="w-4 h-4 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
              </svg>
              この子を共有する
            </p>
           
 <div class="flex space-x-2">
              <button class="flex-1 bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg font-medium transition-colors text-sm">
                Twitter
              </button>
              <button class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg font-medium transition-colors text-sm">
                LINE
     
         </button>
              <button class="flex-1 bg-gray-500 hover:bg-gray-600 text-white py-2 rounded-lg font-medium transition-colors text-sm">
                リンク
              </button>
            </div>
          </div>
        </div>

        
<div class="space-y-4 md:space-y-6">
          
          <div class="bg-white rounded-2xl shadow-xl p-5 md:p-8 border-2 border-orange-100">
            <h1 class="text-2xl md:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-600 mb-2">
              {dog.name}
            </h1>
  
          <p class="text-gray-500 text-sm">ID: {dog.id}</p>
          </div>

          <div class="bg-white rounded-2xl shadow-xl p-5 md:p-8 border-2 border-orange-100">
            <h2 class="text-lg md:text-xl font-bold text-gray-800 mb-6 flex items-center">
              <svg class="w-6 h-6 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              基本情報
            </h2>
            
            <div class="space-y-4">
          
    
