              </div>
              
              {dog.bw && (
                <div class="flex items-start border-b border-gray-100 pb-4">
                  <div 
class="w-20 md:w-24 flex-shrink-0 text-gray-500 font-medium text-sm">体重</div>
                  <div class="flex-1 font-semibold text-gray-800 text-base md:text-lg">
                    {dog.bw}
                  </div>
                </div>
