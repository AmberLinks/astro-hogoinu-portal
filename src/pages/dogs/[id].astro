          )}

                {dog.sns_url && (
                  <a 
                    href={dog.sns_url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center px-4 py-2.5 md:py-2 bg-white hover:bg-blue-50 border border-blue-300 text-blue-600 rounded-lg font-medium transition-colors text-sm"
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
