              </button>
            )}
    
        <p class="text-xs text-gray-500 mt-3 text-center">
              {mailtoHref
                ? "所属団体へメールで問い合わせます"
                : "団体の連絡先メールアドレスが未登録です"}
            </p>
          </div>

        </div>
      </div>

      {dog.description && (
        <div class="bg-white rounded-2xl shadow-xl p-5 md:p-10 mb-8 border-2 border-orange-100">
      
    <h2 class="text-xl md:text-2xl font-bold text-gray-800 mb-6 flex items-center">
            <svg class="w-6 h-6 md:w-7 md:h-7 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
