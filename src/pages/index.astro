---
import { client } from '../lib/microcms';
// ▼ 変更: News と Article を両方インポート
import type { Dog, News, Article, MicroCMSListResponse } from '../types';
import MainLayout from '../layouts/MainLayout.astro';

// --- microCMSから犬データを取得 ---
const dogResponse = await client.get<MicroCMSListResponse<Dog>>({
  endpoint: 'dogs', 
  queries: { 
    limit: 100, 
    orders: '-publishedAt',
    depth: 1 
  }
});
const dogs = dogResponse.contents;

// ▼ 追加: microCMSから「お知らせ(news)」データを取得
let allNews: News[] = [];
try {
  const newsResponse = await client.get<MicroCMSListResponse<News>>({
    endpoint: 'news', // "お知らせ" のエンドポイント名
    queries: {
      limit: 3, // 最新3件
      orders: '-publishedAt'
    }
  });
  allNews = newsResponse.contents;
} catch (e) {
  console.error("お知らせの取得に失敗しました:", e);
}

// ▼ 追加: microCMSから「新着記事(articles)」データを取得
let allArticles: Article[] = [];
try {
  const articleResponse = await client.get<MicroCMSListResponse<Article>>({
    endpoint: 'articles', // "記事" のエンドポイント名
    queries: {
      limit: 3, // 最新3件
      orders: '-publishedAt'
    }
  });
  allArticles = articleResponse.contents;
} catch (e) {
  console.error("記事の取得に失敗しました:", e);
}
// ▲ 追加終わり

console.log('=== データ取得完了 ===');
console.log('取得した犬の総数:', dogs.length);

// ▼▼▼ エラー修正: normalizeField 関数を再定義 ▼▼▼
// データ正規化関数: 配列または文字列を文字列に変換
const normalizeField = (field: string | string[] | undefined | null): string => {
  if (Array.isArray(field) && field.length > 0) {
    return field[0];
}
  if (typeof field === 'string') {
    return field;
  }
  return '';
};
// ▲▲▲ エラー修正ここまで ▲▲▲

// --- 所属団体データの抽出と整形 ---
const groupData = dogs
  .map(dog => dog.group?.group_name)
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });
const uniqueGroups = Array.from(new Set(groupData));
const allGroupNames = uniqueGroups.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});
// --- 犬種データの抽出と整形 ---
const breedData = dogs
  .map(dog => normalizeField(dog.breed)) // ← この行でエラーが発生していました
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });
const uniqueBreeds = Array.from(new Set(breedData));
const allBreedNames = uniqueBreeds.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});
// --- 性別データの抽出と整形 ---
const genderData = dogs
  .map(dog => normalizeField(dog.gender))
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });
const uniqueGenders = Array.from(new Set(genderData));
const allGenderNames = uniqueGenders.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});
// --- ステータスデータの抽出と整形 ---
const statusData = dogs
  .map(dog => normalizeField(dog.status))
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });
const uniqueStatuses = Array.from(new Set(statusData));
const allStatusNames = uniqueStatuses.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});
console.log('抽出された犬種一覧:', allBreedNames);
console.log('抽出された性別一覧:', allGenderNames);
console.log('抽出されたステータス一覧:', allStatusNames);
console.log('抽出された団体一覧:', allGroupNames);

const placeholderIcon = "/dog-placeholder.svg";
---

<MainLayout title="保護犬を探す">
  
  <section class="text-center mb-10 md:mb-12">
    <h1 class="text-2xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-600 mb-4">
      あなたの家族になる子を探そう
    </h1>
    <p class="text-base md:text-xl text-gray-600 max-w-2xl mx-auto">
      静岡県内の保護犬たちが、温かい家庭を待っています
    </p>
  </section>

  {allNews.length > 0 && (
    <section class="mb-8 md:mb-10">
      <div class="bg-white rounded-2xl shadow-lg p-5 md:p-8 border-2 border-gray-200">
        <h2 class="text-xl md:text-2xl font-bold text-gray-800 mb-4 flex items-center">
