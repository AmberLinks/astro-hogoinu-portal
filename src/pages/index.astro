---
import { client } from '../lib/microcms';
import type { Dog, MicroCMSListResponse } from '../types';
import MainLayout from '../layouts/MainLayout.astro';

// microCMSからデータを取得
const response = await client.get<MicroCMSListResponse<Dog>>({
  endpoint: 'dogs', 
  queries: { 
    limit: 100, 
    orders: '-publishedAt',
    depth: 1 
  }
});
const dogs = response.contents;

console.log('=== データ取得完了 ===');
console.log('取得した犬の総数:', dogs.length);

// データ正規化関数: 配列または文字列を文字列に変換
const normalizeField = (field: string | string[] | undefined | null): string => {
  if (Array.isArray(field) && field.length > 0) {
    return field[0];
  }
  if (typeof field === 'string') {
    return field;
  }
  return '';
};

// --- 所属団体データの抽出と整形 ---
const groupData = dogs
  .map(dog => dog.group?.group_name)
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });

const uniqueGroups = Array.from(new Set(groupData));
const allGroupNames = uniqueGroups.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});

// --- 犬種データの抽出と整形 ---
const breedData = dogs
  .map(dog => normalizeField(dog.breed))
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });

const uniqueBreeds = Array.from(new Set(breedData));
const allBreedNames = uniqueBreeds.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});

// --- 性別データの抽出と整形 ---
const genderData = dogs
  .map(dog => normalizeField(dog.gender))
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });

const uniqueGenders = Array.from(new Set(genderData));
const allGenderNames = uniqueGenders.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});

// --- ステータスデータの抽出と整形 ---
const statusData = dogs
  .map(dog => normalizeField(dog.status))
  .filter((name): name is string => {
    return typeof name === 'string' && name.trim() !== '';
  });

const uniqueStatuses = Array.from(new Set(statusData));
const allStatusNames = uniqueStatuses.sort((a, b) => {
  return a.localeCompare(b, 'ja-JP', { 
    sensitivity: 'base',
    numeric: true 
  });
});

console.log('抽出された犬種一覧:', allBreedNames);
console.log('抽出された性別一覧:', allGenderNames);
console.log('抽出されたステータス一覧:', allStatusNames);
console.log('抽出された団体一覧:', allGroupNames);

const placeholderIcon = "/dog-placeholder.svg"; 
---

<MainLayout title="保護犬一覧">
  <h1 class="text-3xl font-bold mb-6">保護犬一覧</h1>

  <form id="search-form" class="bg-white p-6 rounded-lg shadow-md mb-8 space-y-4">
    <h2 class="text-xl font-semibold mb-2">条件で探す</h2>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      
      <div>
        <label for="search-group" class="block text-sm font-medium text-gray-700">所属団体</label>
        <select 
          id="search-group" 
          name="group" 
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
        >
          <option value="">すべての団体</option>
          {allGroupNames.map(name => (
            <option value={name}>{name}</option>
          ))}
        </select>
        <p class="text-xs text-gray-500 mt-1">登録団体数: {allGroupNames.length}</p>
      </div>

      <div>
        <label for="search-breed" class="block text-sm font-medium text-gray-700">犬種</label>
        <select 
          id="search-breed" 
          name="breed" 
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
        >
          <option value="">すべての犬種</option>
          {allBreedNames.map(name => (
            <option value={name}>{name}</option>
          ))}
        </select>
        <p class="text-xs text-gray-500 mt-1">登録犬種数: {allBreedNames.length}</p>
      </div>

      <div>
        <label for="search-gender" class="block text-sm font-medium text-gray-700">性別</label>
        <select 
          id="search-gender" 
          name="gender" 
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
        >
          <option value="">すべて</option>
          {allGenderNames.map(name => (
            <option value={name}>{name}</option>
          ))}
        </select>
        <p class="text-xs text-gray-500 mt-1">登録性別数: {allGenderNames.length}</p>
      </div>

      <div>
        <label for="search-status" class="block text-sm font-medium text-gray-700">ステータス</label>
        <select 
          id="search-status" 
          name="status" 
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
        >
          <option value="">すべて</option>
          {allStatusNames.map(name => (
            <option value={name}>{name}</option>
          ))}
        </select>
        <p class="text-xs text-gray-500 mt-1">登録ステータス数: {allStatusNames.length}</p>
      </div>
      
    </div>

    <div class="pt-4">
      <label for="search-keyword" class="block text-sm font-medium text-gray-700">フリーワード</label>
      <input 
        type="text" 
        id="search-keyword" 
        placeholder="名前、年齢、体重、紹介文など"
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
      />
    </div>

  </form>

  <div id="result-count" class="mb-4 text-gray-600">
    全 <span id="visible-count">{dogs.length}</span> 件 / <span id="total-count">{dogs.length}</span> 件
  </div>

  <div id="dog-list-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    
    {dogs.map(dog => {
      const breedValue = normalizeField(dog.breed);
      const genderValue = normalizeField(dog.gender);
      const statusValue = normalizeField(dog.status);
      
      return (
        <a 
          href={`/dogs/${dog.id}/`} 
          class="dog-card bg-white rounded-lg shadow-lg overflow-hidden transition-transform transform hover:scale-105"
          
          data-breed={breedValue}
          data-gender={genderValue}
          data-status={statusValue}
          data-group_name={dog.group?.group_name || ''}
          
          data-name={dog.name || ''}
          data-age={dog.age || ''}
          data-bw={dog.bw || ''}
          data-description={(dog.description || '').replace(/<[^>]+>/g, '')}
        >
          <img 
            src={dog.image_url || placeholderIcon} 
            alt={dog.name}
            class="w-full h-48 object-cover"
          />
          
          <div class="p-4">
            <h2 class="text-xl font-bold text-blue-800 mb-2">{dog.name}</h2>
            <div class="space-y-1 text-gray-700">
              <p><strong>犬種:</strong> {breedValue || 'MIX / 不明'}</p>
              <p><strong>年齢:</strong> {dog.age || '不明'}</p>
              <p><strong>体重:</strong> {dog.bw || '不明'}</p>
              <p><strong>性別:</strong> {genderValue || '未設定'}</p>
              {dog.group && (
                <p><strong>所属:</strong> {dog.group.group_name}</p>
              )}
            </div>
            
            {statusValue && (
              <div class="mt-4">
                <span class="inline-block bg-green-200 text-green-800 text-xs px-2 py-1 rounded-full">
                  {statusValue}
                </span>
              </div>
            )}
          </div>
        </a>
      );
    })}
    
  </div>
</MainLayout>

<script>
  function filterDogs() {
    const keywordValue = (document.getElementById('search-keyword') as HTMLInputElement)?.value.toLowerCase() || '';
    const breedValue = (document.getElementById('search-breed') as HTMLSelectElement)?.value || '';
    const genderValue = (document.getElementById('search-gender') as HTMLSelectElement)?.value || '';
    const statusValue = (document.getElementById('search-status') as HTMLSelectElement)?.value || '';
    const groupValue = (document.getElementById('search-group') as HTMLSelectElement)?.value || '';

    const cards = document.querySelectorAll('.dog-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const dogCard = card as HTMLElement;

      const cardBreed = dogCard.dataset.breed || '';
      const cardGender = dogCard.dataset.gender || '';
      const cardStatus = dogCard.dataset.status || '';
      const cardGroupName = dogCard.dataset.group_name || ''; 
      
      const cardName = (dogCard.dataset.name || '').toLowerCase();
      const cardAge = (dogCard.dataset.age || '').toLowerCase();
      const cardBw = (dogCard.dataset.bw || '').toLowerCase();
      const cardDescription = (dogCard.dataset.description || '').toLowerCase();

      const isBreedMatch = (breedValue === "") || (cardBreed === breedValue);
      const isGenderMatch = (genderValue === "") || (cardGender === genderValue);
      const isStatusMatch = (statusValue === "") || (cardStatus === statusValue);
      const isGroupMatch = (groupValue === "") || (cardGroupName === groupValue);

      const isKeywordMatch = (keywordValue === "") || 
                             (cardName.includes(keywordValue)) ||
                             (cardAge.includes(keywordValue)) ||
                             (cardBw.includes(keywordValue)) ||
                             (cardDescription.includes(keywordValue));

      if (isBreedMatch && isGenderMatch && isStatusMatch && isGroupMatch && isKeywordMatch) {
        dogCard.style.display = 'block';
        visibleCount++;
      } else {
        dogCard.style.display = 'none';
      }
    });

    const visibleCountElement = document.getElementById('visible-count');
    if (visibleCountElement) {
      visibleCountElement.textContent = visibleCount.toString();
    }

    console.log(`表示件数: ${visibleCount} / ${cards.length}`);
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('search-keyword')?.addEventListener('input', filterDogs);
    document.getElementById('search-breed')?.addEventListener('change', filterDogs);
    document.getElementById('search-gender')?.addEventListener('change', filterDogs);
    document.getElementById('search-status')?.addEventListener('change', filterDogs);
    document.getElementById('search-group')?.addEventListener('change', filterDogs);
    
    console.log('検索フォームの初期化完了');
  });
</script>