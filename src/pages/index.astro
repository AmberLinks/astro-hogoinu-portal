       >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span>リセット</span>
          </button>
        
</div>

      </form>
    </div>
  </section>

  <div class="mb-4 md:mb-6 flex items-center justify-between">
    <div id="result-count" class="text-base md:text-lg font-semibold text-gray-700 flex items-center space-x-2">
      <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
      </svg>
   
   <span>
        表示中 <span id="visible-count" class="text-orange-600 font-bold">{dogs.length}</span> 件 
        <span class="text-gray-400">/ 全 {dogs.length} 件</span>
      </span>
    </div>
    
    <div class="hidden md:block">
      <select class="px-4 py-2 rounded-lg border-2 border-gray-200 text-sm focus:border-orange-400 outline-none cursor-pointer">
        <option>新着順</option>
        <option>名前順</option>
      </select>
    </div>
  </div>

  
<div id="dog-list-container" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
    
    {dogs.map(dog => {
      const breedValue = normalizeField(dog.breed);
const genderValue = normalizeField(dog.gender);
      const statusValue = normalizeField(dog.status);
      
      return (
        <a 
          href={`/dogs/${dog.id}/`} 
          class="dog-card group bg-white rounded-2xl shadow-md hover:shadow-2xl overflow-hidden transition-all duration-300 transform hover:-translate-y-1 border-2 border-transparent hover:border-orange-300"
          
          data-breed={breedValue}
          data-gender={genderValue}
          data-status={statusValue}
        
  data-group_name={dog.group?.group_name || ''}
          
          data-name={dog.name || ''}
          data-age={dog.age || ''}
          data-bw={dog.bw || ''}
          data-description={(dog.description || '').replace(/<[^>]+>/g, '')}
        >
          <div class="relative overflow-hidden aspect-square">
    
        <img 
              src={dog.image_url || placeholderIcon} 
              alt={dog.name}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            
                     {statusValue && (
              <div class="absolute top-2 right-2 md:top-3 md:right-3">
                <span class="inline-block bg-gradient-to-r from-green-400 to-green-600 text-white text-xs font-bold px-2.5 py-1 md:px-3 md:py-1.5 rounded-full shadow-lg">
                  {statusValue}
                </span>
           
   </div>
            )}
            
            <div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-black/30 to-transparent"></div>
          </div>
          
             <div class="p-4 md:p-5">
            <h2 class="text-lg md:text-xl font-bold text-gray-800 mb-2 md:mb-3 group-hover:text-orange-600 transition-colors flex items-center">
              {dog.name}
              <svg class="w-4 h-4 md:w-5 md:h-5 ml-1.5 md:ml-2 text-orange-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            
  </svg>
            </h2>
            
            <div class="space-y-1.5 md:space-y-2 text-xs md:text-sm text-gray-600">
              <div class="flex items-start">
                <span class="text-gray-400 w-12 md:w-16 flex-shrink-0">犬種</span>
                <span class="font-medium text-gray-700">{breedValue ||
'MIX / 不明'}</span>
              </div>
              
              <div class="flex items-start">
                <span class="text-gray-400 w-12 md:w-16 flex-shrink-0">年齢</span>
                <span class="font-medium text-gray-700">{dog.age ||
'不明'}</span>
              </div>
              
              {dog.bw && (
                <div class="flex items-start">
                  <span class="text-gray-400 w-12 md:w-16 flex-shrink-0">体重</span>
                 
 <span class="font-medium text-gray-700">{dog.bw}</span>
                </div>
              )}
              
              <div class="flex items-start">
                <span class="text-gray-400 w-12 md:w-16 flex-shrink-0">性別</span>
                <span class="font-medium 
text-gray-700">{genderValue || '未設定'}</span>
              </div>
              
              {dog.group && (
                <div class="pt-2 mt-2 border-t border-gray-100">
                  <p class="text-xs text-gray-500 flex items-center">
            
        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
           
         </svg>
                    {dog.group.group_name}
                  </p>
                </div>
              )}
            </div>
          </div>
 
       </a>
      );
})}
    
  </div>

  <div id="no-results" class="hidden text-center py-16">
    <div class="inline-block p-8 bg-white rounded-2xl shadow-lg">
      <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h3 class="text-xl font-bold text-gray-700 mb-2">該当する犬が見つかりませんでした</h3>
      <p class="text-gray-500 mb-4">別の条件で検索してみてください</p>
     
 <button 
        id="reset-button-2"
        class="px-6 py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-lg font-medium transition-colors"
      >
        条件をリセット
      </button>
    </div>
  </div>

</MainLayout>

<script>
  function filterDogs() {
    const keywordValue = (document.getElementById('search-keyword') as HTMLInputElement)?.value.toLowerCase() ||
'';
    const breedValue = (document.getElementById('search-breed') as HTMLSelectElement)?.value || '';
    const genderValue = (document.getElementById('search-gender') as HTMLSelectElement)?.value || '';
const statusValue = (document.getElementById('search-status') as HTMLSelectElement)?.value || '';
    const groupValue = (document.getElementById('search-group') as HTMLSelectElement)?.value || '';

    const cards = document.querySelectorAll('.dog-card');
let visibleCount = 0;

    cards.forEach(card => {
      const dogCard = card as HTMLElement;

      const cardBreed = dogCard.dataset.breed || '';
      const cardGender = dogCard.dataset.gender || '';
      const cardStatus = dogCard.dataset.status || '';
      const cardGroupName = dogCard.dataset.group_name || ''; 
      
      const cardName = (dogCard.dataset.name || '').toLowerCase();
      const cardAge = (dogCard.dataset.age || '').toLowerCase();
      const cardBw = (dogCard.dataset.bw 
|| '').toLowerCase();
      const cardDescription = (dogCard.dataset.description || '').toLowerCase();

      const isBreedMatch = (breedValue === "") || (cardBreed === breedValue);
      const isGenderMatch = (genderValue === "") || (cardGender === genderValue);
      const isStatusMatch = (statusValue === "") || (cardStatus === statusValue);
      const isGroupMatch = (groupValue === "") || (cardGroupName === groupValue);

      const isKeywordMatch = (keywordValue === "") || 
               
              (cardName.includes(keywordValue)) ||
                             (cardAge.includes(keywordValue)) ||
                             (cardBw.includes(keywordValue)) ||
(cardDescription.includes(keywordValue));

      if (isBreedMatch && isGenderMatch && isStatusMatch && isGroupMatch && isKeywordMatch) {
        dogCard.style.display = 'block';
visibleCount++;
      } else {
        dogCard.style.display = 'none';
      }
    });
const visibleCountElement = document.getElementById('visible-count');
    if (visibleCountElement) {
      visibleCountElement.textContent = visibleCount.toString();
}

    // 結果なしメッセージの表示/非表示
    const noResults = document.getElementById('no-results');
    const dogListContainer = document.getElementById('dog-list-container');
if (noResults && dogListContainer) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
dogListContainer.classList.add('hidden');
      } else {
        noResults.classList.add('hidden');
        dogListContainer.classList.remove('hidden');
}
    }

    console.log(`表示件数: ${visibleCount} / ${cards.length}`);
}

  function resetFilters() {
    // すべての入力をリセット
    (document.getElementById('search-keyword') as HTMLInputElement).value = '';
(document.getElementById('search-breed') as HTMLSelectElement).value = '';
    (document.getElementById('search-gender') as HTMLSelectElement).value = '';
    (document.getElementById('search-status') as HTMLSelectElement).value = '';
    (document.getElementById('search-group') as HTMLSelectElement).value = '';
// フィルタを再実行
    filterDogs();
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('search-keyword')?.addEventListener('input', filterDogs);
    document.getElementById('search-breed')?.addEventListener('change', filterDogs);
    document.getElementById('search-gender')?.addEventListener('change', filterDogs);
    document.getElementById('search-status')?.addEventListener('change', filterDogs);
    document.getElementById('search-group')?.addEventListener('change', filterDogs);
    
    // リセットボタンのイベント
    document.getElementById('reset-button')?.addEventListener('click', resetFilters);
    document.getElementById('reset-button-2')?.addEventListener('click', resetFilters);
    
    console.log('検索フォームの初期化完了');
  });
</script>